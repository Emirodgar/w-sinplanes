---
import Base from '../layouts/Base.astro';
import PlanList from './PlanList.astro';
import SearchBox from './SearchBox.astro';
import CategoryFilter from './CategoryFilter.astro';
import { t, url } from '../i18n/ui.js';
import { ptitle, inLang } from '../lib/data.js';
const { lang, title, intro, route, noindex, chips = null } = Astro.props;
const seasonal = inLang(Astro.props.seasonal || [], lang);
const dated = inLang(Astro.props.dated || [], lang);
const fixed = inLang(Astro.props.fixed || [], lang);
const groups = (Astro.props.groups || []).map((g) => ({ ...g, plans: inLang(g.plans, lang) })).filter((g) => g.plans.length);
const L = t[lang];
const total = seasonal.length + dated.length + fixed.length + groups.reduce((n, g) => n + g.plans.length, 0);
const site = Astro.site.origin;
const all = [...dated, ...fixed, ...groups.flatMap((g) => g.plans), ...seasonal];
const jsonld = total ? {
  '@context': 'https://schema.org', '@type': 'ItemList', name: title,
  itemListElement: all.slice(0, 30).map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: ptitle(p, lang), url: `${site}${url.plan(lang, p.slug)}` })),
} : null;
---
<Base lang={lang} title={title} description={intro} route={route} noindex={noindex ?? total < 3} jsonld={jsonld}>
  <header class="page-head">
    <h1>{title}</h1>
    {intro && <p>{intro}</p>}
    <p class="muted">{L.plansCount(total)}</p>
  </header>
  {chips}
  {total > 0 && <SearchBox lang={lang} />}
  <slot />
  {seasonal.length > 0 && <section class="section"><h2>{L.seasonalSection}</h2><PlanList lang={lang} plans={seasonal} /></section>}
  {(dated.length > 0 || (seasonal.length === 0 && fixed.length === 0 && groups.length === 0)) && <section class="section">{(seasonal.length > 0 || fixed.length > 0) && <h2>{L.datedSection}</h2>}{dated.length >= 8 && <CategoryFilter lang={lang} plans={dated} />}<PlanList lang={lang} plans={dated} showTopic /></section>}
  {fixed.length > 0 && <section class="section"><h2>{L.fixedSection}</h2><PlanList lang={lang} plans={fixed} showTopic /></section>}
  {groups.map((g) => <section class="section"><h2>{g.title}<span class="count">{g.plans.length}</span></h2><PlanList lang={lang} plans={g.plans} /></section>)}
</Base>
