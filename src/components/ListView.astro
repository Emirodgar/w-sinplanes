---
import Base from '../layouts/Base.astro';
import PlanList from './PlanList.astro';
import { t, url } from '../i18n/ui.js';
import { ptitle, inLang } from '../lib/data.js';
const { lang, title, intro, route, noindex, chips = null } = Astro.props;
const seasonal = inLang(Astro.props.seasonal || [], lang);
const dated = inLang(Astro.props.dated || [], lang);
const L = t[lang];
const total = seasonal.length + dated.length;
const site = Astro.site.origin;
const all = [...seasonal, ...dated];
const jsonld = total ? {
  '@context': 'https://schema.org', '@type': 'ItemList', name: title,
  itemListElement: all.slice(0, 30).map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: ptitle(p, lang), url: `${site}${url.plan(lang, p.slug)}` })),
} : null;
---
<Base lang={lang} title={title} description={intro} route={route} noindex={noindex ?? total < 3} jsonld={jsonld}>
  <header class="page-head">
    <h1>{title}</h1>
    {intro && <p>{intro}</p>}
    <p class="muted">{L.plansCount(total)}</p>
  </header>
  {chips}
  <slot />
  {seasonal.length > 0 && <section class="section"><h2>{L.seasonalSection}</h2><PlanList lang={lang} plans={seasonal} /></section>}
  {(dated.length > 0 || seasonal.length === 0) && <section class="section">{seasonal.length > 0 && <h2>{L.datedSection}</h2>}<PlanList lang={lang} plans={dated} showTopic /></section>}
</Base>
