---
import cine from '../../data/cine.json';
import { t } from '../i18n/ui.js';
import { pickText } from '../lib/data.js';

const { lang } = Astro.props;
const L = t[lang];
const films = cine.peliculas;
const img = (path, w) => `https://image.tmdb.org/t/p/w${w}${path}`;
const kidsCount = films.filter((f) => f.publico === 'ninos').length;
---
{films.length > 0 && (
  <section class="widget widget--wide cine" aria-labelledby="w-cine" data-cine>
    <div class="cine-head">
      <h2 id="w-cine">{L.w.cine}</h2>
      {kidsCount > 0 && kidsCount < films.length && (
        <ul class="chips cine-filter" aria-label={L.cineFilter}>
          <li><button type="button" class="chip" data-aud="" aria-pressed="true">{L.cineAll}</button></li>
          <li><button type="button" class="chip" data-aud="ninos" aria-pressed="false">{L.cineKids}</button></li>
          <li><button type="button" class="chip" data-aud="adultos" aria-pressed="false">{L.cineAdults}</button></li>
        </ul>
      )}
    </div>
    <div class="cine-track">
    <button type="button" class="cine-nav cine-nav--prev" aria-label={L.cinePrev} disabled>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>
    <button type="button" class="cine-nav cine-nav--next" aria-label={L.cineNext}>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>
    <ul class="cine-strip" tabindex="0">
      {films.map((f) => {
        const title = pickText(f.titulo, lang).text;
        const aud = f.publico === 'ninos' ? L.cineKids : L.cineAdults;
        return (
          <li class="film" data-aud={f.publico}>
            <div class="poster">
              <img src={img(f.poster, 342)} srcset={`${img(f.poster, 185)} 185w, ${img(f.poster, 342)} 342w, ${img(f.poster, 500)} 500w`}
                sizes="(min-width: 46rem) 10rem, 8rem" alt={title} width="342" height="513" loading="lazy" decoding="async" />
              <span class={`badge badge--${f.publico}`}>{aud}{f.edad && f.edad !== 'TP' ? ` +${f.edad}` : ''}</span>
            </div>
            <p class="film-title">{title}</p>
          </li>
        );
      })}
    </ul>
    </div>
    <p class="cine-note muted">{L.cineNote}</p>
  </section>
)}

<script>
  const root = document.querySelector('[data-cine]');
  if (root) {
    const chips = [...root.querySelectorAll('[data-aud]:is(button)')];
    const strip = root.querySelector('.cine-strip');
    const prev = root.querySelector('.cine-nav--prev');
    const next = root.querySelector('.cine-nav--next');
    const sync = () => {
      prev.disabled = strip.scrollLeft < 4;
      next.disabled = strip.scrollLeft > strip.scrollWidth - strip.clientWidth - 4;
    };
    const page = (dir) => strip.scrollBy({ left: dir * strip.clientWidth * 0.85, behavior: 'smooth' });
    chips.forEach((chip) => chip.addEventListener('click', () => {
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      root.querySelectorAll('.film').forEach((f) => { f.hidden = Boolean(chip.dataset.aud) && f.dataset.aud !== chip.dataset.aud; });
      strip.scrollLeft = 0;
      sync();
    }));
    prev.addEventListener('click', () => page(-1));
    next.addEventListener('click', () => page(1));
    strip.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync);
    strip.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); page(1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); page(-1); }
    });

    // Arrastrar con el ratón (en táctil ya se desplaza solo)
    let down = null, moved = false;
    strip.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      down = { x: e.clientX, left: strip.scrollLeft };
      moved = false;
    });
    window.addEventListener('pointermove', (e) => {
      if (!down) return;
      const dx = e.clientX - down.x;
      if (!moved && Math.abs(dx) > 5) { moved = true; strip.classList.add('is-dragging'); }
      if (moved) strip.scrollLeft = down.left - dx;
    });
    const end = () => { down = null; strip.classList.remove('is-dragging'); };
    window.addEventListener('pointerup', end);
    window.addEventListener('pointercancel', end);
    strip.addEventListener('dragstart', (e) => e.preventDefault());
    strip.addEventListener('click', (e) => { if (moved) { e.preventDefault(); e.stopPropagation(); moved = false; } }, true);
    sync();
  }
</script>
