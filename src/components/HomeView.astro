---
import Base from '../layouts/Base.astro';
import PlanList from './PlanList.astro';
import NearMe from './NearMe.astro';
import SearchBox from './SearchBox.astro';
import CineWidget from './CineWidget.astro';
import DailyPick from './DailyPick.astro';
import MatchToday from './MatchToday.astro';
import TodayIn from './TodayIn.astro';
import { t, url, monthName, HREFLANG, INTL_LOCALE } from '../i18n/ui.js';
import { TODAY, currentMonth, seasonalFor, upcoming, within, overlaps, weekendRange, span, isCourse, topicById, fmtDay, cap, ptitle, psummary, textLang, trending, boost, inLang } from '../lib/data.js';

const { lang } = Astro.props;
const L = t[lang];
const m = currentMonth();
const [wFrom, wTo] = weekendRange();
const local = inLang(upcoming(), lang).filter((p) => p.kind === 'evento');

const season = boost(inLang(seasonalFor(m), lang)).slice(0, 5);
// Un plan de "este finde" no puede durar meses ni ser un curso: las exposiciones de todo el año no son un plan para el sábado.
// Los widgets "Gratis" y "Con niños" aplican el mismo criterio (con más margen) para no repetir los planes permanentes de siempre.
const weekend = boost(local.filter((p) => overlaps(p, wFrom, wTo) && span(p) <= 14 && !isCourse(p))).slice(0, 5);
const watch = boost(inLang(upcoming(), lang).filter((p) => p.kind === 'pantalla')).slice(0, 5);
const fresh = (p) => span(p) <= 45 && !isCourse(p);
const free = inLang(within(21), lang).filter((p) => p.free && fresh(p)).slice(0, 5);
const kids = inLang(within(30), lang).filter((p) => p.topics?.includes('ninos') && fresh(p)).slice(0, 5);
const trend = inLang(trending(30), lang).slice(0, 5);
const next = inLang(upcoming(), lang).filter((p) => p.recurring && p.kind === 'evento').slice(0, 5);

const kidsT = topicById('ninos');
const watchT = topicById('pantalla');
const jsonld = {
  '@context': 'https://schema.org', '@type': 'WebSite', name: 'sinplanes', url: Astro.site.href,
  inLanguage: HREFLANG[lang], description: L.tagline,
};
---
<Base lang={lang} route={{ type: 'home' }} jsonld={jsonld}>
  <section class="hero">
    <h1>{L.heroQ}</h1>
    <p data-today={TODAY} data-locale={INTL_LOCALE[lang]} data-label={cap(fmtDay(lang, TODAY))}>{L.heroToday(cap(fmtDay(lang, TODAY)))}</p>
    {L.heroSpain && <p class="hero-note">{L.heroSpain}</p>}
  </section>
  <script is:inline>
    // El HTML se genera en el build; si el despliegue diario se retrasa, la fecha del saludo se corrige aquí con la de hoy en Madrid.
    (function () {
      var p = document.querySelector('[data-today]');
      if (!p) return;
      try {
        var now = new Date();
        var iso = now.toLocaleDateString('sv-SE', { timeZone: 'Europe/Madrid' });
        if (iso === p.dataset.today) return;
        var label = new Intl.DateTimeFormat(p.dataset.locale, { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'Europe/Madrid' }).format(now);
        label = label.charAt(0).toUpperCase() + label.slice(1);
        p.textContent = p.textContent.replace(p.dataset.label, label);
      } catch (e) {}
    })();
  </script>

  <TodayIn lang={lang} />

  <SearchBox lang={lang} mode="index" />

  <section class="season" data-search-hide aria-labelledby="w-season">
    <div>
      <p class="month" aria-hidden="true">{cap(monthName(lang, m))}</p>
      <h2 id="w-season">{L.w.season(monthName(lang, m))}</h2>
      <a href={url.month(lang, m)}>{L.seeAll}</a>
    </div>
    <ul>
      {season.map((p) => (
        <li>
          <a href={url.plan(lang, p.slug)} lang={textLang(lang, p)}>{ptitle(p, lang)}</a>
          <p lang={textLang(lang, p)}>{psummary(p, lang)}</p>
        </li>
      ))}
    </ul>
  </section>

  <div class="widgets" data-search-hide>
    <MatchToday lang={lang} />

    <section class="widget" aria-labelledby="w-weekend">
      <h2 id="w-weekend">{L.w.weekend}</h2>
      <PlanList lang={lang} plans={weekend} />
    </section>

    <NearMe lang={lang} />

    <section class="widget" aria-labelledby="w-watch">
      <h2 id="w-watch">{L.w.watch}</h2>
      <PlanList lang={lang} plans={watch} />
      <a class="more" href={url.topic(lang, watchT)}>{L.seeAll}</a>
    </section>

    <section class="widget" aria-labelledby="w-free">
      <h2 id="w-free">{L.w.free}</h2>
      <PlanList lang={lang} plans={free} />
    </section>

    <DailyPick lang={lang} kinds={['book', 'podcast']} />

    <section class="widget" aria-labelledby="w-kids">
      <h2 id="w-kids">{L.w.kids}</h2>
      <PlanList lang={lang} plans={kids} />
      <a class="more" href={url.topic(lang, kidsT)}>{L.seeAll}</a>
    </section>

    {trend.length > 0 && (
      <section class="widget" aria-labelledby="w-trend">
        <h2 id="w-trend">{L.w.trending}</h2>
        <p class="muted">{L.trendingIntro}</p>
        <PlanList lang={lang} plans={trend} />
      </section>
    )}

    <CineWidget lang={lang} />

    <DailyPick lang={lang} kinds={['movie', 'series']} />

    <section class="widget" aria-labelledby="w-next">
      <h2 id="w-next">{L.w.next}</h2>
      <PlanList lang={lang} plans={next} />
      <a class="more" href={url.calendar(lang)}>{L.nav.calendar}</a>
    </section>
  </div>
</Base>
