---
// Cuatro recomendaciones para el día: una serie, un libro, un podcast y una película. Se eligen en el build con una
// semilla por fecha (todos los visitantes ven las mismas ese día y cambian solas con el despliegue diario).
// Una categoría sin datos simplemente no sale.
import series from '../../data/series.json';
import libros from '../../data/libros.json';
import podcasts from '../../data/podcasts.json';
import peliculas from '../../data/peliculas.json';
import BookCover from './BookCover.astro';
import PodcastCover from './PodcastCover.astro';
import { t, url } from '../i18n/ui.js';
import { pickText, TODAY } from '../lib/data.js';

const { lang } = Astro.props;
const L = t[lang];

const hash = (s) => [...s].reduce((a, c) => (Math.imul(a, 31) + c.charCodeAt(0)) >>> 0, 7);
const img = (path, w) => `https://image.tmdb.org/t/p/w${w}${path}`;
const choose = (kind, pool) => (pool.length ? pool[hash(`${TODAY}:${kind}`) % pool.length] : null);

const movieIds = new Set();
const moviePool = [...(peliculas.top || []), ...(peliculas.azar || [])].filter((m) => !movieIds.has(m.id) && movieIds.add(m.id));

const cards = [
  { kind: 'series', label: L.w.dailySeries, item: choose('series', series.mejores || []), href: url.series(lang) },
  { kind: 'book', label: L.w.dailyBook, item: choose('book', libros.todos || (libros.actual ? [libros.actual] : [])), href: url.books(lang) },
  { kind: 'podcast', label: L.w.dailyPodcast, item: choose('podcast', podcasts.todos || (podcasts.actual ? [podcasts.actual] : [])), href: url.podcasts(lang) },
  { kind: 'movie', label: L.w.dailyMovie, item: choose('movie', moviePool), href: url.movies(lang) },
].filter((c) => c.item).map((c) => {
  const tmdb = c.kind === 'series' || c.kind === 'movie';
  const obj = c.kind === 'podcast' ? c.item.descripcion : c.item.sinopsis;
  return {
    ...c,
    tmdb,
    title: tmdb ? pickText(c.item.titulo, lang).text : c.item.titulo,
    byline: c.kind === 'series' ? (c.item.plataformas || []).join(' · ') : c.kind === 'movie' ? (c.item.anio || '') : c.item.autor,
    text: obj ? pickText(obj, lang) : null,
  };
});
---
{cards.length > 0 && (
  <section class="widget widget--wide daily" aria-labelledby="w-daily" data-search-hide>
    <h2 id="w-daily">{L.w.daily}</h2>
    <ul class="daily-grid">
      {cards.map((c) => (
        <li class="daily-card">
          <a class="daily-cover" href={c.href} tabindex="-1" aria-hidden="true">
            {c.tmdb && (
              <img class="book-cover daily-poster" src={img(c.item.poster, 342)} srcset={`${img(c.item.poster, 185)} 185w, ${img(c.item.poster, 342)} 342w`}
                sizes="6.5rem" alt="" width="342" height="513" loading="lazy" decoding="async" />
            )}
            {c.kind === 'book' && <BookCover book={c.item} />}
            {c.kind === 'podcast' && <PodcastCover podcast={c.item} />}
          </a>
          <div class="daily-body">
            <p class="book-eyebrow">{c.label}</p>
            <p class="book-title"><a href={c.href}>{c.title}</a></p>
            {c.byline && <p class="book-author">{c.byline}</p>}
            {c.text?.text && <p class="book-synopsis daily-text" lang={c.text.lang !== lang ? c.text.lang : undefined}>{c.text.text}</p>}
          </div>
        </li>
      ))}
    </ul>
  </section>
)}
