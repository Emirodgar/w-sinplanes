---
import Base from '../layouts/Base.astro';
import CalendarMenu from './CalendarMenu.astro';
import { t, url, LANGS, HREFLANG } from '../i18n/ui.js';
import { fmtWhen, fmtPlace, topicById, isPast, isPlace, textLang, slugify, ptitle, psummary, availLangs, plans } from '../lib/data.js';

const { lang, plan: p } = Astro.props;
const L = t[lang];
const title = ptitle(p, lang);
const summary = psummary(p, lang);
const past = isPast(p);
const pl = p.place || {};
const tl = textLang(lang, p);

// Event solo cuando hay fecha y lugar físico (requisito de Google para resultados de eventos)
const address = { '@type': 'PostalAddress', addressLocality: pl.municipio, addressRegion: pl.provincia, addressCountry: 'ES' };
const baseJsonld = isPlace(p) ? (pl.scope !== 'local' ? null : {
  '@context': 'https://schema.org', '@type': 'TouristAttraction',
  name: title, description: summary, inLanguage: HREFLANG[tl || lang], address,
  ...(p.source?.url ? { url: p.source.url } : {}),
}) : p.kind !== 'estacional' && pl.scope === 'local' && !past ? {
  '@context': 'https://schema.org', '@type': 'Event',
  name: title, description: summary,
  startDate: p.time ? `${p.start}T${p.time}` : p.start, endDate: p.end || p.start,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  inLanguage: HREFLANG[tl || lang],
  location: {
    '@type': 'Place', name: pl.venue || pl.municipio,
    address: { '@type': 'PostalAddress', addressLocality: pl.municipio, addressRegion: pl.provincia, addressCountry: 'ES' },
    ...(pl.lat && pl.lon ? { geo: { '@type': 'GeoCoordinates', latitude: pl.lat, longitude: pl.lon } } : {}),
  },
  ...(p.free ? { isAccessibleForFree: true } : {}),
  ...(p.source?.url ? { url: p.source.url } : {}),
} : null;

// Ficha ampliada (texto, imagen y preguntas frecuentes): por ahora solo existe en castellano.
const extra = lang === 'es' && !tl ? p.content?.es : null;
const faq = extra?.faq || [];
const related = (p.related || []).map((slug) => plans.find((x) => x.slug === slug && x.kind === p.kind)).filter(Boolean);
const faqLd = faq.length ? {
  '@context': 'https://schema.org', '@type': 'FAQPage', inLanguage: 'es',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.p, acceptedAnswer: { '@type': 'Answer', text: f.r } })),
} : null;
const jsonld = [baseJsonld, faqLd].filter(Boolean);
---
<Base lang={lang} title={title} description={summary || [title, fmtWhen(lang, p), fmtPlace(p, L.allSpain)].filter(Boolean).join(' · ')} route={{ type: 'plan', slug: p.slug }} avail={availLangs(p, LANGS)} noindex={past || !!tl} jsonld={jsonld.length ? jsonld : null} image={extra && p.image ? p.image : null}>
  <article class="plan">
    <h1 lang={tl}>{title}</h1>
    {summary && <p class="lead" lang={tl}>{summary}</p>}

    {extra && p.image && (
      <figure class="plan-figure">
        <img src={p.image} alt={extra.imagen_alt || title} width={p.imageSize?.[0]} height={p.imageSize?.[1]} loading="eager" decoding="async" />
      </figure>
    )}

    {past && <p class="notice">{L.past}</p>}
    {p.approx && <p class="notice">{L.approx}</p>}

    <dl class="facts">
      <dt>{L.when}</dt><dd>{fmtWhen(lang, p)}{p.recurring && ` (${L.inRecurring})`}</dd>
      <dt>{L.where}</dt>
      <dd>
        {pl.scope === 'local' && pl.ccaa
          ? <a href={url.province(lang, pl.ccaa, slugify(pl.provincia))}>{fmtPlace(p, L.allSpain)}</a>
          : fmtPlace(p, L.allSpain)}
        {pl.venue && <><br />{pl.venue}</>}
      </dd>
      {(p.free || p.price) && <><dt>{L.price}</dt><dd>{p.free ? L.free_ : p.price}</dd></>}
      {typeof p.indoor === 'boolean' && <><dt>{L.setting}</dt><dd>{p.indoor ? L.indoor : L.outdoor}</dd></>}
      <dt>{L.nav.topics}</dt>
      <dd>{p.topics.map((id, i) => { const tp = topicById(id); return tp && <>{i > 0 && ', '}<a href={url.topic(lang, tp)}>{tp[lang]}</a></>; })}</dd>
      {p.source?.name && p.source.name !== 'sinplanes' && <><dt>{L.sourceLabel}</dt><dd>{p.source.name}{p.source.license && <span class="muted"> ({p.source.license})</span>}</dd></>}
    </dl>

    {extra?.texto?.length > 0 && (
      <div class="plan-body">
        {extra.texto.map((para) => <p>{para}</p>)}
      </div>
    )}

    {faq.length > 0 && (
      <section class="plan-faq" aria-labelledby="faq-title">
        <h2 id="faq-title">Preguntas frecuentes</h2>
        {faq.map((f) => (
          <details>
            <summary>{f.p}</summary>
            <p>{f.r}</p>
          </details>
        ))}
      </section>
    )}

    {related.length > 0 && (
      <section class="plan-related" aria-labelledby="rel-title">
        <h2 id="rel-title">Planes relacionados</h2>
        <ul>
          {related.map((r) => <li><a href={url.plan(lang, r.slug)}>{ptitle(r, lang)}</a></li>)}
        </ul>
      </section>
    )}

    {!past && (
      <div class="plan-actions">
        <CalendarMenu lang={lang} plan={p} />
        {p.source?.url && <a class="button button--ghost" href={p.source.url} target="_blank" rel="noopener noreferrer">{L.source}<span class="visually-hidden"> ({L.newTab})</span></a>}
      </div>
    )}
    {past && p.source?.url && <a class="button" href={p.source.url} target="_blank" rel="noopener noreferrer">{L.source}<span class="visually-hidden"> ({L.newTab})</span></a>}
  </article>
</Base>
