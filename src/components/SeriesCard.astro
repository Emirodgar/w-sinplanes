---
// Ficha de una serie en la cuadrícula de /series (la ficha del carrusel de la home va en SeriesWidget.astro).
import { t } from '../i18n/ui.js';
import { pickText } from '../lib/data.js';

const { s, lang, showDate = false } = Astro.props;
const L = t[lang];
const img = (path, w) => `https://image.tmdb.org/t/p/w${w}${path}`;
const title = pickText(s.titulo, lang).text;
const rating = s.nota == null ? null : s.nota.toLocaleString(lang, { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const premiere = showDate && s.estreno
  ? new Date(`${s.estreno}T12:00:00Z`).toLocaleDateString(lang, { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })
  : null;
---
<li class="film" data-series-card data-aud={s.publico} data-plat={s.plataformas.join('|')}>
  <a class="film-link" href={`https://www.themoviedb.org/tv/${s.id}`} target="_blank" rel="noopener noreferrer">
    <div class="poster">
      <img src={img(s.poster, 342)} srcset={`${img(s.poster, 185)} 185w, ${img(s.poster, 342)} 342w, ${img(s.poster, 500)} 500w`}
        sizes="(min-width: 46rem) 10rem, 40vw" alt={title} width="342" height="513" loading="lazy" decoding="async" />
      {rating && <span class="badge badge--rating" title={L.seriesRating}>★ {rating}</span>}
    </div>
    <p class="film-title">{title}</p>
  </a>
  {premiere && <p class="film-where muted">{L.seriesPremiere(premiere)}</p>}
  {s.plataformas.length > 0 && <p class="film-where muted">{s.plataformas.join(' · ')}</p>}
</li>
