---
// Página /series: serie al azar, mejor valoradas y últimas novedades (datos de TMDB, ver scripts/lib/series.mjs).
import Base from '../layouts/Base.astro';
import SeriesCard from './SeriesCard.astro';
import series from '../../data/series.json';
import { t } from '../i18n/ui.js';
import { pickText, TODAY } from '../lib/data.js';

const { lang, route } = Astro.props;
const L = t[lang];
const { mejores, novedades, estrenos = [] } = series;
const empty = mejores.length === 0;
const all = [...new Map([...mejores, ...novedades, ...estrenos].map((s) => [s.id, s])).values()];

const img = (path, w) => `https://image.tmdb.org/t/p/w${w}${path}`;
const fmt = (n) => n.toLocaleString(lang, { minimumFractionDigits: 1, maximumFractionDigits: 1 });
// Datos que necesita el selector del navegador para la serie al azar (solo en el idioma de la página).
const pool = all.map((s) => ({
  id: s.id, title: pickText(s.titulo, lang).text, plot: pickText(s.sinopsis || {}, lang).text, poster: s.poster,
  rating: s.nota == null ? null : fmt(s.nota), year: s.anio, where: s.plataformas, aud: s.publico,
}));
// Serie inicial del HTML: una distinta cada día (el navegador la sustituye por una al azar al cargar).
const dayIndex = Math.floor(Date.parse(TODAY) / 864e5);
const first = pool.length ? pool[dayIndex % pool.length] : null;
const meta = (p) => [p.rating && `★ ${p.rating}`, p.year, p.where.join(' · ')].filter(Boolean).join(' · ');

const platCount = {};
for (const s of all) for (const p of s.plataformas) platCount[p] = (platCount[p] || 0) + 1;
const platforms = Object.entries(platCount).sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0])).slice(0, 8).map(([name]) => name);
const hasKids = all.some((s) => s.publico === 'ninos') && all.some((s) => s.publico === 'adultos');

const jsonld = {
  '@context': 'https://schema.org', '@type': 'ItemList', name: L.seriesTitle,
  itemListElement: mejores.slice(0, 20).map((s, i) => ({ '@type': 'ListItem', position: i + 1, item: { '@type': 'TVSeries', name: pickText(s.titulo, lang).text, url: `https://www.themoviedb.org/tv/${s.id}` } })),
};
const safeJSON = (o) => JSON.stringify(o).replace(/</g, '\\u003c');
---
<Base lang={lang} title={L.seriesTitle} description={L.seriesIntro} route={route} noindex={empty} jsonld={empty ? null : jsonld}>
  <header class="page-head">
    <h1>{L.seriesTitle}</h1>
    <p>{L.seriesIntro}</p>
  </header>

  {empty && <p class="empty">{L.seriesEmpty}</p>}

  {!empty && (
    <div data-series>
      {first && (
        <section class="series-pick" aria-labelledby="s-pick" data-series-pick>
          <h2 id="s-pick">{L.seriesPick}</h2>
          <div class="series-pick__card">
            <div class="poster series-pick__poster">
              <img data-pick-img src={img(first.poster, 342)} srcset={`${img(first.poster, 342)} 342w, ${img(first.poster, 500)} 500w`}
                sizes="(min-width: 40rem) 12rem, 60vw" alt={first.title} width="342" height="513" decoding="async" />
            </div>
            <div class="series-pick__body" aria-live="polite">
              <h3 data-pick-title>{first.title}</h3>
              <p class="series-pick__meta muted" data-pick-meta>{meta(first)}</p>
              <p data-pick-plot>{first.plot}</p>
              <p class="series-pick__actions">
                <button type="button" class="chip" data-pick-next>{L.seriesAnother}</button>
                <a data-pick-link href={`https://www.themoviedb.org/tv/${first.id}`} target="_blank" rel="noopener noreferrer">{L.seriesOpen}</a>
              </p>
            </div>
          </div>
          <script type="application/json" data-pick-pool set:html={safeJSON(pool)} />
        </section>
      )}

      {(hasKids || platforms.length > 1) && (
        <div class="series-filters">
          {hasKids && (
            <ul class="chips" aria-label={L.cineFilter}>
              <li><button type="button" class="chip" data-f="aud" data-v="" aria-pressed="true">{L.cineAll}</button></li>
              <li><button type="button" class="chip" data-f="aud" data-v="ninos" aria-pressed="false">{L.cineKids}</button></li>
              <li><button type="button" class="chip" data-f="aud" data-v="adultos" aria-pressed="false">{L.cineAdults}</button></li>
            </ul>
          )}
          {platforms.length > 1 && (
            <ul class="chips" aria-label={L.seriesPlatform}>
              <li><button type="button" class="chip" data-f="plat" data-v="" aria-pressed="true">{L.seriesPlatAll}</button></li>
              {platforms.map((p) => <li><button type="button" class="chip" data-f="plat" data-v={p} aria-pressed="false">{p}</button></li>)}
            </ul>
          )}
        </div>
      )}

      {estrenos.length > 0 && (
        <section class="series-section" aria-labelledby="s-fresh">
          <h2 id="s-fresh">{L.seriesFresh}</h2>
          <p class="muted">{L.seriesFreshNote}</p>
          <ul class="series-grid">
            {estrenos.map((s) => <SeriesCard s={s} lang={lang} showDate />)}
          </ul>
        </section>
      )}

      <section class="series-section" aria-labelledby="s-best">
        <h2 id="s-best">{L.seriesBest}</h2>
        <p class="muted">{L.seriesNote}</p>
        <ul class="series-grid">
          {mejores.map((s) => <SeriesCard s={s} lang={lang} />)}
        </ul>
      </section>

      {novedades.length > 0 && (
        <section class="series-section" aria-labelledby="s-new">
          <h2 id="s-new">{L.seriesNew}</h2>
          <p class="muted">{L.seriesNewNote}</p>
          <ul class="series-grid">
            {novedades.map((s) => <SeriesCard s={s} lang={lang} showDate />)}
          </ul>
        </section>
      )}
    </div>
  )}
</Base>

<script>
  const root = document.querySelector('[data-series]');
  const poolEl = root?.querySelector('[data-pick-pool]');
  if (root && poolEl) {
    const pool = JSON.parse(poolEl.textContent);
    const state = { aud: '', plat: '' };
    const cards = [...root.querySelectorAll('[data-series-card]')];
    const el = (s) => root.querySelector(s);
    const img = el('[data-pick-img]');
    const matches = (aud, plats) => (!state.aud || aud === state.aud) && (!state.plat || plats.includes(state.plat));
    let current = pool.find((p) => img.alt === p.title) || null;

    const show = (p) => {
      current = p;
      img.src = `https://image.tmdb.org/t/p/w342${p.poster}`;
      img.srcset = `https://image.tmdb.org/t/p/w342${p.poster} 342w, https://image.tmdb.org/t/p/w500${p.poster} 500w`;
      img.alt = p.title;
      el('[data-pick-title]').textContent = p.title;
      el('[data-pick-meta]').textContent = [p.rating && `★ ${p.rating}`, p.year, p.where.join(' · ')].filter(Boolean).join(' · ');
      el('[data-pick-plot]').textContent = p.plot;
      el('[data-pick-link]').href = `https://www.themoviedb.org/tv/${p.id}`;
    };
    const pick = () => {
      const options = pool.filter((p) => matches(p.aud, p.where));
      const others = options.filter((p) => p.id !== current?.id);
      const list = others.length ? others : options;
      if (list.length) show(list[Math.floor(Math.random() * list.length)]);
    };

    root.querySelectorAll('[data-f]').forEach((chip) => chip.addEventListener('click', () => {
      state[chip.dataset.f] = chip.dataset.v;
      root.querySelectorAll(`[data-f="${chip.dataset.f}"]`).forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      cards.forEach((c) => { c.hidden = !matches(c.dataset.aud, c.dataset.plat.split('|')); });
      if (!current || !matches(current.aud, current.where)) pick();
    }));
    el('[data-pick-next]').addEventListener('click', pick);
    if (pool.length > 1) pick(); // al cargar: una serie al azar en lugar de la del día
  }
</script>
