---
import Base from '../layouts/Base.astro';
import BookCover from './BookCover.astro';
import libros from '../../data/libros.json';
import { t, url, monthName } from '../i18n/ui.js';
import { pickText, norm, cap } from '../lib/data.js';

const { lang, route } = Astro.props;
const L = t[lang];
const list = libros.historico;
const label = (g) => pickText(libros.generos[g], lang).text;
// solo géneros con algún libro, en el orden del fichero
const genres = Object.keys(libros.generos).filter((g) => list.some((b) => b.generos?.includes(g)));
const when = (ym) => { const [y, m] = ym.split('-').map(Number); return `${cap(monthName(lang, m))} ${y}`; };
const site = Astro.site.origin;
const jsonld = {
  '@context': 'https://schema.org', '@type': 'ItemList', name: L.booksTitle,
  itemListElement: list.slice(0, 30).map((b, i) => ({ '@type': 'ListItem', position: i + 1, item: { '@type': 'Book', name: b.titulo, author: { '@type': 'Person', name: b.autor }, ...(b.motivo && { award: b.motivo.es }) } })),
};
---
<Base lang={lang} title={L.booksTitle} description={L.booksIntro} route={route} jsonld={jsonld}>
  <header class="page-head">
    <h1>{L.booksTitle}</h1>
    <p>{L.booksIntro}</p>
  </header>

  <div class="books-tools" data-books data-none={L.searchNone}>
    <div class="search" role="search">
      <label class="visually-hidden" for="books-q">{L.booksSearchLabel}</label>
      <input id="books-q" type="search" autocomplete="off" enterkeyhint="search" placeholder={L.booksSearch} />
    </div>
    {genres.length > 1 && (
      <ul class="chips books-genres" aria-label={L.booksGenres}>
        <li><button type="button" class="chip" data-genre="" aria-pressed="true">{L.booksAllGenres}</button></li>
        {genres.map((g) => <li><button type="button" class="chip" data-genre={g} aria-pressed="false">{label(g)}</button></li>)}
      </ul>
    )}
    <p class="search-status muted" aria-live="polite"></p>
  </div>

  <ul class="books-grid">
    {list.map((b) => {
      const syn = pickText(b.sinopsis, lang);
      const why = b.motivo ? pickText(b.motivo, lang) : null;
      const gl = (b.generos || []).map(label);
      return (
        <li class="book-card" data-genres={(b.generos || []).join(' ')} data-q={norm(`${b.titulo} ${b.autor} ${gl.join(' ')} ${why?.text || ''}`)}>
          <BookCover book={b} />
          <div class="book-card-body">
            <p class="book-eyebrow" lang={why ? why.lang : undefined}>{why?.text || when(b.mes)}</p>
            <h2 class="book-title">{b.titulo}</h2>
            <p class="book-author">{b.autor}</p>
            <p class="book-synopsis" lang={syn.lang !== lang ? syn.lang : undefined}>{syn.text}</p>
            {gl.length > 0 && <p class="book-tags">{gl.map((g) => <span>{g}</span>)}</p>}
          </div>
        </li>
      );
    })}
  </ul>
  <p class="empty" hidden data-books-empty>{L.searchNone}</p>
</Base>

<script>
  const root = document.querySelector('[data-books]');
  if (root) {
    const input = root.querySelector('input');
    const status = root.querySelector('.search-status');
    const empty = document.querySelector('[data-books-empty]');
    const cards = [...document.querySelectorAll('.book-card')];
    const chips = [...root.querySelectorAll('[data-genre]')];
    const norm = (s) => String(s).normalize('NFD').replace(/\p{M}/gu, '').toLowerCase();
    let genre = '';
    const run = () => {
      const words = norm(input.value).split(/\s+/).filter(Boolean);
      let shown = 0;
      for (const c of cards) {
        const ok = words.every((w) => c.dataset.q.includes(w)) && (!genre || c.dataset.genres.split(' ').includes(genre));
        c.hidden = !ok;
        if (ok) shown++;
      }
      empty.hidden = shown > 0;
      status.textContent = '';
    };
    input.addEventListener('input', run);
    chips.forEach((chip) => chip.addEventListener('click', () => {
      genre = chip.dataset.genre;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      run();
    }));
  }
</script>
